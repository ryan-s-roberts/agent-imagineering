      "sender": "Maya Chen (Property Manager, Northbridge Lettings)",
      "channel": "Note",
      "text": "Move-out remedial request logged from inspection notes. No photographs or other supporting documents were provided with the request.",
      "start": 145,
      "end": 277
    },
    {
      "id": "002:L1",
      "event_id": "002",
      "timestamp": "2025-09-04 13:26:00 UTC",
      "sender": "Maya Chen (Property Manager, Northbridge Lettings)",
