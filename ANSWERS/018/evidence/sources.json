      "event_id": "007",
      "timestamp": "2025-08-18 11:26:02 UTC",
      "sender": "Tara Wren (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "Records that the landlord will arrange the works directly and asks him to provide an expected completion date and confirm when they are complete. No contractor, scope, or target date is included in the email.",
