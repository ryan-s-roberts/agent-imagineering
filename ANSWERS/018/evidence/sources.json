      "end": 326
    },
    {
      "id": "008:L1",
      "event_id": "008",
      "timestamp": "2025-08-18 11:26:05 UTC",
      "sender": "Tara Wren (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "- **Channel:** Email",
      "start": 0,
      "end": 20
    },
    {
