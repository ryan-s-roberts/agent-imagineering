      "event_id": "010",
      "timestamp": "2025-09-01 12:02:31 UTC",
      "sender": "Elise Rowan (Tenant)",
      "channel": "Email",
      "text": "Says pest-control visits are ongoing, with a final visit expected the following Monday. Says the landlord wants openings beneath the kitchen sink blocked, but this has not been done yet.",
