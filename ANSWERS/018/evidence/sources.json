      "text": "- **Channel:** Email",
      "start": 0,
      "end": 20
    },
    {
      "id": "007:L2",
      "event_id": "007",
      "timestamp": "2025-08-18 11:26:02 UTC",
      "sender": "Tara Wren (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "- **From:** Tara Wren (Property Manager, Northbridge Lettings)",
