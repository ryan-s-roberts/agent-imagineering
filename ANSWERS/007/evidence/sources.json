    {
      "id": "001:L5",
      "event_id": "001",
      "timestamp": "2025-09-04 13:05:32 UTC",
      "sender": "Ada Pell (Tenant, Brindlewick)",
      "channel": "Portal",
      "text": "Reported that a Samsung TV in the upstairs bedroom had an internal electrical fault and, in the tenant's description, shorted out and repeatedly tripped a fuse when plugged in. The tenant said the TV had seen little overall use and was unplugged to avoid further damage. Also reported that the downstairs bedroom light flickered and made a popping noise when switched on. Asked that access be scheduled in advance because a dog was at the property.",
      "start": 127,
      "end": 575
    },
    {
      "id": "002:L1",
      "event_id": "002",
      "timestamp": "2025-09-04 14:55:42 UTC",
      "sender": "Mina Voss (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "- **Channel:** Email",
      "start": 0,
      "end": 20
    },
    {
      "id": "002:L2",
      "event_id": "002",
      "timestamp": "2025-09-04 14:55:42 UTC",
      "sender": "Mina Voss (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "- **From:** Mina Voss (Property Manager, Northbridge Lettings)",
      "start": 21,
      "end": 83
    },
    {
      "id": "002:L3",
      "event_id": "002",
      "timestamp": "2025-09-04 14:55:42 UTC",
      "sender": "Mina Voss (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "- **To:** Corin Wex (Landlord, Brindlewick)",
      "start": 84,
      "end": 127
    },
    {
      "id": "002:L5",
      "event_id": "002",
      "timestamp": "2025-09-04 14:55:42 UTC",
      "sender": "Mina Voss (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "Requested approval to arrange works for the TV fault, classifying the request as appliance repairs. The description included the tenant-reported shorting and repeated fuse trips, that the TV was unplugged, and the low reported use. This approval request did not include the downstairs light.",
      "start": 129,
      "end": 420
    },
    {
      "id": "003:L1",
      "event_id": "003",
      "timestamp": "2025-09-05 11:37:04 UTC",
      "sender": "Corin Wex (Landlord, Brindlewick)",
      "channel": "Email",
      "text": "- **Channel:** Email",
      "start": 0,
      "end": 20
    },
    {
      "id": "003:L2",
      "event_id": "003",
      "timestamp": "2025-09-05 11:37:04 UTC",
      "sender": "Corin Wex (Landlord, Brindlewick)",
      "channel": "Email",
      "text": "- **From:** Corin Wex (Landlord, Brindlewick)",
      "start": 21,
      "end": 66
    },
    {
      "id": "003:L3",
      "event_id": "003",
      "timestamp": "2025-09-05 11:37:04 UTC",
      "sender": "Corin Wex (Landlord, Brindlewick)",
      "channel": "Email",
      "text": "- **To:** Mina Voss (Property Manager, Northbridge Lettings)",
      "start": 67,
      "end": 127
    },
    {
      "id": "003:L5",
      "event_id": "003",
      "timestamp": "2025-09-05 11:37:04 UTC",
      "sender": "Corin Wex (Landlord, Brindlewick)",
      "channel": "Email",
      "text": "Replied, “Please sort it. I don't remember leaving a TV.” The reply followed the TV-focused request. It did not mention the downstairs light or expressly address ownership, replacement, or disposal of the television.",
      "start": 129,
      "end": 345
    },
