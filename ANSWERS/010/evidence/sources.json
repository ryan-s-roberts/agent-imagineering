      "event_id": "006",
      "timestamp": "2025-09-09 16:49:18 UTC",
      "sender": "Nia Calder (Property Manager, Northbridge Lettings)",
      "channel": "Update",
      "text": "Recorded landlord approval for the original laminate-repair scope. This recorded approval was limited to that scope; it did not approve a full kitchen replacement or replacement of cupboards and doors.",
      "start": 149,
      "end": 350
    },
    {
      "id": "007:L1",
      "event_id": "007",
      "timestamp": "2025-09-09 16:50:18 UTC",
      "sender": "Nia Calder (Property Manager, Northbridge Lettings)",
