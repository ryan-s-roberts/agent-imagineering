      "event_id": "003",
      "timestamp": "2025-09-04 14:57:45 UTC",
      "sender": "Nia Calder (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "Sent the tenant's description, flagging the reported cuts, doors that do not close properly, and the need to arrange access around two dogs. Asked whether the landlord was happy for Northbridge Lettings to arrange the work.",
      "start": 118,
      "end": 341
    },
    {
      "id": "004:L1",
      "event_id": "004",
      "timestamp": "2025-09-06 09:07:13 UTC",
      "sender": "Soren Pike (Landlord)",
      "channel": "Email",
      "text": "- **Channel:** Email",
      "start": 0,
      "end": 20
    },
    {
      "id": "004:L2",
      "event_id": "004",
      "timestamp": "2025-09-06 09:07:13 UTC",
      "sender": "Soren Pike (Landlord)",
      "channel": "Email",
      "text": "- **From:** Soren Pike (Landlord)",
      "start": 21,
      "end": 54
    },
    {
