      "event_id": "002",
      "timestamp": "2025-09-04 12:31:00 UTC",
      "sender": "Nia Calder (Property Manager, Northbridge Lettings)",
      "channel": "Email",
      "text": "Acknowledged the report and said the landlord would be contacted about the work. Noted that any visit would need to be coordinated in advance around the dogs.",
