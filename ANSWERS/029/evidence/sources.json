      "id": "012:L5",
      "event_id": "012",
      "timestamp": "2025-05-13 08:03:00 UTC",
      "sender": "Tamsin Rook (Property Manager, Northbridge Lettings)",
      "channel": "Call",
      "text": "Bram says Wednesday was not booked as a confirmed appointment and that he has not started travelling. He describes the task as an initial visual check and pressure reading, not a specified repair. He does not provide a business landline during the call.",
      "start": 147,
      "end": 400
    },
    {
      "id": "013:L1",
      "event_id": "013",
      "timestamp": "2025-05-13 08:29:00 UTC",
