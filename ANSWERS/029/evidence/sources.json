      "event_id": "016",
      "timestamp": "2025-05-13 12:26:00 UTC",
      "sender": "Bram Alder (Contractor, Hearthline Boiler Service)",
      "channel": "Email",
      "text": "- **To:** Tamsin Rook (Property Manager, Northbridge Lettings)",
      "start": 84,
      "end": 146
    },
    {
      "id": "016:L5",
      "event_id": "016",
      "timestamp": "2025-05-13 12:26:00 UTC",
      "sender": "Bram Alder (Contractor, Hearthline Boiler Service)",
      "channel": "Email",
      "text": "Bram says Saturday might be possible but he has not checked his schedule. He asks for the tenant's mobile number so he can coordinate directly. No visit time or company contact details are provided.",
      "start": 148,
      "end": 346
    },
    {
      "id": "017:L1",
      "event_id": "017",
