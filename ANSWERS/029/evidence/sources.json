      "id": "017:L5",
      "event_id": "017",
      "timestamp": "2025-05-13 14:05:00 UTC",
      "sender": "Tamsin Rook (Property Manager, Northbridge Lettings)",
      "channel": "Note",
      "text": "Tenancy record holds Elowen Vey's contact details. Consent field for disclosure to Bram Alder: EMPTY. Appointment correspondence logged: tenant message of 13 May at 11:41 and contractor email of 13 May at 12:26.",
